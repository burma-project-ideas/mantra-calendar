@page "/"
@using BlazorWasm.MantraCalendarApp.Services
@using Blazored.LocalStorage
@inject MantraScheduleService mantraScheduleService
@inject ILocalStorageService LocalStorage
@inject DialogService DialogService

<h3>Mantra Practice Calendar</h3>

<RadzenScheduler @ref="scheduler" TItem="Appointment" Data="@appointments" StartProperty="Start" EndProperty="End"
                 TextProperty="Text" SlotSelect="OnSlotSelect" AppointmentSelect="OnAppointmentSelect">
    <RadzenMonthView />
    <RadzenYearPlannerView StartMonth="@startMonth" />
    <RadzenYearTimelineView StartMonth="@startMonth" />
    <RadzenYearView StartMonth="@startMonth" />
</RadzenScheduler>

@code {
    private RadzenScheduler<Appointment> scheduler;
    private Month startMonth = Month.January;

    // Initialize appointments list
    IList<Appointment> appointments = new List<Appointment>();

    protected override async Task OnInitializedAsync()
    {
        var mantraSchedules = mantraScheduleService.GetMantraTypes();

        // Generate appointments, grouping by dates
        appointments = mantraSchedules.SelectMany(mantra =>
        {
            var dailyAppointments = new List<Appointment>();
            var groupedDates = mantra.MantraTypes
                .SelectMany(m => GenerateDatesForMantra(mantra.StartDate, mantra.EndDate)
                .Select(date => new { Date = date, Mantra = m }))
                .GroupBy(d => d.Date)
                .ToList();

            foreach (var group in groupedDates)
            {
                dailyAppointments.Add(new Appointment
                {
                    Start = group.Key,
                    End = group.Key,
                    Text = $"Mantras on {group.Key.ToString("dd.MM.yyyy")}",
                    Description = "Multiple mantras on this day.",
                    Mantras = group.Select(g => g.Mantra).ToList(),
                    IsPracticed = false // Initially set to pending
                });
            }
            return dailyAppointments;
        }).ToList();

        await LoadProgress();
    }

    // Method to generate dates based on the start and end date of the mantra schedule
    private List<DateTime> GenerateDatesForMantra(DateTime startDate, DateTime endDate)
    {
        var dates = new List<DateTime>();
        for (var date = startDate; date <= endDate; date = date.AddDays(1))
        {
            dates.Add(date);
        }
        return dates;
    }

    // Color the slot depending on the status of all mantras for that day
    void OnSlotRender(SchedulerSlotRenderEventArgs args)
    {
        var appointmentsForTheDay = appointments.Where(a => a.Start.Date == args.Start.Date).ToList();

        // Check if all mantras for the day are marked as complete (IsPracticed = true)
        bool allComplete = appointmentsForTheDay.All(a => a.Mantras.All(m => m.IsPracticed));

        // If all appointments for the day are complete, mark the day green, otherwise yellow
        if (allComplete)
        {
            args.Attributes["style"] = "background-color: green;";
        }
        else
        {
            args.Attributes["style"] = "background-color: yellow;";
        }
    }

    async Task OnSlotSelect(SchedulerSlotSelectEventArgs args)
    {
        var data = new Appointment
        {
            Start = args.Start,
            End = args.End,
            Text = "New Appointment"
        };

        var result = await DialogService.OpenAsync<EditMantraPopup>("Edit Mantra", new Dictionary<string, object>
        {
            { "Start", args.Start },
            { "End", args.End },
            { "Appointment", data }
        });

        if (result != null)
        {
            appointments.Add(result); // Add the new appointment to the list
            await scheduler.Reload();
        }
    }

    async Task OnAppointmentSelect(SchedulerAppointmentSelectEventArgs<Appointment> args)
    {
        var selectedAppointment = args.Data;

        // Open the dialog to edit the selected appointment
        var updatedAppointment = await DialogService.OpenAsync<EditMantraPopup>("Edit Mantra", new Dictionary<string, object>
        {
            { "Appointment", selectedAppointment }
        });

        if (updatedAppointment != null)
        {
            var index = appointments.IndexOf(selectedAppointment);
            if (index >= 0)
            {
                appointments[index] = updatedAppointment; // Update the appointment
                await scheduler.Reload();
            }
            await SaveProgress();
        }
    }

    // Save the progress to LocalStorage
    private async Task SaveProgress()
    {
        var progress = appointments.SelectMany(a => a.Mantras.Select(m => new
        {
            Date = a.Start.Date,
            MantraName = m.Name,
            IsPracticed = m.IsPracticed
        })).ToList();

        await LocalStorage.SetItemAsync("mantraProgress", progress);
    }

    // Load the progress from LocalStorage
    private async Task LoadProgress()
    {
        var savedProgress = await LocalStorage.GetItemAsync<List<dynamic>>("mantraProgress");

        if (savedProgress != null)
        {
            foreach (var progress in savedProgress)
            {
                var appointment = appointments.FirstOrDefault(a => a.Start.Date == progress.Date);
                if (appointment != null)
                {
                    var mantra = appointment.Mantras.FirstOrDefault(m => m.Name == progress.MantraName);
                    if (mantra != null)
                    {
                        mantra.IsPracticed = progress.IsPracticed;
                    }
                }
            }
        }
    }
}
