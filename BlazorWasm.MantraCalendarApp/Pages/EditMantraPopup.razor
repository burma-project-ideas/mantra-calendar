@inject BlazorWasm.MantraCalendarApp.Services.UiLanguage L
@using BlazorWasm.MantraCalendarApp.Services
@inject DialogService DialogService

<p class="dialog-intro">@L["Take a moment to reflect. Mark the mantras you practiced today."]</p>
<RadzenTemplateForm TItem="Appointment" Data="@model" Submit="@OnSubmit">
    <div class="mantra-list">
        @for (var i = 0; i < model.Mantras.Count; i++)
        {
            var mantra = model.Mantras[i];
            var controlName = $"mantra-{i}";
            <div class="mantra-row @(mantra.IsPracticed ? "is-complete" : "")">
                <RadzenCheckBox TValue="bool" @bind-Value="mantra.IsPracticed" Name="@controlName" />
                <RadzenLabel Component="@controlName" Text="@mantra.Name" Style="flex: 1;" lang="my" />
            </div>
        }
    </div>
    <div class="dialog-actions">
        <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Light" Text="@L["Cancel"]" Click="@(() => DialogService.Close())" />
        <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save practice"]" />
    </div>
</RadzenTemplateForm>

@code {
    [Parameter, EditorRequired]
    public Appointment Appointment { get; set; } = new();
    private Appointment model = new();

    protected override void OnParametersSet() => model = Appointment.Copy();
    private void OnSubmit(Appointment updatedAppointment) => DialogService.Close(updatedAppointment);
}

