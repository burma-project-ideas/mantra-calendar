@inherits LayoutComponentBase
<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>
<RadzenComponents />
<a class="skip-link" href="#practice-calendar">Skip to calendar</a>
<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="" aria-label="Mantra Practice Calendar home">
            <span class="brand-mark" aria-hidden="true"><RadzenIcon Icon="spa" /></span>
            <span>mantra<span class="brand-caption">A DAILY PRACTICE</span></span>
        </a>
        <span class="local-note"><RadzenIcon Icon="check_circle_outline" aria-hidden="true" /> Stored in this browser</span>
    </header>
    <main id="main-content" class="app-main">
        @Body
    </main>
    <footer class="app-footer">A practice you can return to.<span>Stored in this browser. Export a backup to keep a copy.</span></footer>
</div>
