@inherits LayoutComponentBase
<HeadContent>
    <RadzenTheme Theme="material" />
</HeadContent>
<RadzenComponents />
<a class="skip-link" href="#main-content">Skip to calendar</a>
<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="" aria-label="Mantra Practice Calendar home">
            <span class="brand-mark" aria-hidden="true"><RadzenIcon Icon="spa" /></span>
            <span>Mantra<span class="brand-caption">PRACTICE JOURNAL</span></span>
        </a>
        <span class="local-note"><RadzenIcon Icon="check_circle_outline" aria-hidden="true" /> Saved on this device</span>
    </header>
    <main id="main-content" class="app-main">
        @Body
    </main>
    <footer class="app-footer">One day, one practice at a time.<span>Progress stays in this browser.</span></footer>
</div>
